# OpenAI: распознавание товара по фотографии.
# В production секреты читает deploy только на сервере; API-ключ не передаётся в основной Worker.
OPENAI_API_KEY=
# HTTP/HTTPS/SOCKS proxy URL для внутреннего OpenAI gateway, например http://user:pass@host:port
OPENAI_PROXY_URL=
# Для локального прямого режима можно оставить пустым; production использует http://openai-gateway:8080
OPENAI_BASE_URL=
# В production генерируется автоматически и хранится только на сервере
OPENAI_GATEWAY_TOKEN=
OPENAI_VISION_MODEL=gpt-5.6-luna

# Wildberries seller API
WB_API_TOKEN=
WB_CLIENT_SECRET=

# Ozon seller API
OZON_CLIENT_ID=
OZON_API_KEY=

# Яндекс Маркет Partner API
YANDEX_MARKET_API_KEY=
YANDEX_MARKET_BUSINESS_ID=

# Пользователи, роли и шифрование кабинетов продавцов
# standalone — собственные email/пароль и сессии на сервере; chatgpt — авторизация Sites
AUTH_MODE=standalone
# Включайте после подключения шлюза email; существующие аккаунты при миграции считаются подтверждёнными
EMAIL_VERIFICATION_REQUIRED=false
ADMIN_EMAILS=
DEV_USER_EMAIL=
# Сгенерируйте случайные 32 байта и сохраните как base64
CREDENTIAL_ENCRYPTION_KEY=

# Платёжный контур: sandbox не списывает деньги; webhook подключает лицензированного партнёра
PAYMENT_PROVIDER=sandbox
# Для боевого режима: seller_direct, bank_safe_deal или split_payment
PAYMENT_MODEL=disabled
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=

# Проверка продавцов
KYC_PROVIDER=
KYC_API_KEY=

# Доставка: ApiShip объединяет десятки служб, ПВЗ, расчёт и создание отправлений
# Глобальный токен платформы. Продавец также может сохранить свой токен в кабинете.
DELIVERY_PROVIDER=apiship
APISHIP_API_TOKEN=
# Совместимый резерв для прежней конфигурации
DELIVERY_API_KEY=
DELIVERY_WEBHOOK_SECRET=

# Email/SMS/push через единый защищённый шлюз и фоновые задания
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
# Если пусто на сервере, production deploy создаёт постоянный случайный секрет автоматически.
CRON_SECRET=

# Эксплуатация и публичный запуск
MONITORING_WEBHOOK_URL=
BACKUP_POLICY_CONFIRMED=false
# true только после заполнения реквизитов во всех документах и проверки юристом
LEGAL_OPERATOR_REQUISITES_CONFIRMED=false
# true после внесения фактических банков, перевозчиков и обработчиков данных
PRIVACY_PROCESSORS_CONFIRMED=false
PUBLIC_APP_URL=
PUBLIC_ACCESS_ENABLED=false
