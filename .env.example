# OpenAI: распознавание товара по фотографии
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-nano

# Wildberries seller API
WB_API_TOKEN=
WB_CLIENT_SECRET=

# Ozon seller API
OZON_CLIENT_ID=
OZON_API_KEY=

# Яндекс Маркет Partner API
YANDEX_MARKET_API_KEY=
YANDEX_MARKET_BUSINESS_ID=

# Пользователи, роли и шифрование кабинетов продавцов
# standalone — собственные email/пароль и сессии на сервере; chatgpt — авторизация Sites
AUTH_MODE=standalone
# Включайте после подключения шлюза email; существующие аккаунты при миграции считаются подтверждёнными
EMAIL_VERIFICATION_REQUIRED=false
ADMIN_EMAILS=
DEV_USER_EMAIL=
# Сгенерируйте случайные 32 байта и сохраните как base64
CREDENTIAL_ENCRYPTION_KEY=

# Платёжный контур: sandbox не списывает деньги; webhook подключает лицензированного партнёра
PAYMENT_PROVIDER=sandbox
# Для боевого режима: seller_direct, bank_safe_deal или split_payment
PAYMENT_MODEL=disabled
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=

# Проверка продавцов и доставка
KYC_PROVIDER=
KYC_API_KEY=
DELIVERY_PROVIDER=
DELIVERY_API_KEY=
DELIVERY_WEBHOOK_SECRET=

# Email/SMS/push через единый защищённый шлюз и фоновые задания
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
CRON_SECRET=

# Эксплуатация и публичный запуск
MONITORING_WEBHOOK_URL=
BACKUP_POLICY_CONFIRMED=false
# true только после заполнения реквизитов во всех документах и проверки юристом
LEGAL_OPERATOR_REQUISITES_CONFIRMED=false
# true после внесения фактических банков, перевозчиков и обработчиков данных
PRIVACY_PROCESSORS_CONFIRMED=false
PUBLIC_APP_URL=
PUBLIC_ACCESS_ENABLED=false
