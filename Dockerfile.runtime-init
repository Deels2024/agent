FROM python:3.13-slim

WORKDIR /runtime-init
COPY runtime-init/init_runtime.py /runtime-init/init_runtime.py

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    RUNTIME_SHARED_DIR=/run/shared \
    RUNTIME_OPENAI_DIR=/run/openai \
    INTEGRATION_ENV_FILE=/run/integration/bureau.env

HEALTHCHECK --interval=10s --timeout=3s --start-period=2s --retries=3 \
  CMD python -c "import pathlib; p=pathlib.Path('/run/shared'); names=('ready','openai_gateway_token','cron_secret','openai_config_status.json'); raise SystemExit(0 if all((p/n).is_file() and (p/n).stat().st_size>0 for n in names) else 1)"

CMD ["python", "/runtime-init/init_runtime.py"]
